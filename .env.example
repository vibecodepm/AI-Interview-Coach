# .env.example

# --- System Configuration ---
# Optional local provider configuration. The application defaults to MockLLMClient.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:latest
OLLAMA_TIMEOUT_SECONDS=90

# --- Optional/Future Cloud Providers (Not required for MVP) ---
# OPENAI_API_KEY=
# CLOUD_PROVIDER_ENABLED=false
